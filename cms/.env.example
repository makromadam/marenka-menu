# Marenka CMS — ortam ayarları (.env.example)
# Bu dosyayı ".env" olarak kopyalayın ve değerleri kendinize göre değiştirin:
#   cp .env.example .env

# Yönetim paneli girişi (MUTLAKA değiştirin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=marenka

# Sunucu portu
PORT=3000

# Oturum imzalama anahtarı. Boş bırakırsanız ilk açılışta otomatik üretilir ve
# veritabanına kaydedilir. Üretimde uzun, rastgele bir değer verin.
# SESSION_SECRET=degistirin-uzun-rastgele-bir-deger

# HTTPS arkasında çalışıyorsanız çerezi "Secure" yapmak için 1 yapın
# (ters proxy x-forwarded-proto gönderiyorsa otomatik de algılanır).
# COOKIE_SECURE=1

# Veritabanı dosyasının yolu (varsayılan: data/menu.db)
# DB_PATH=./data/menu.db
